# Each CTest invocation owns its isolated output directory.
file(REMOVE_RECURSE "${OUTPUT}")
execute_process(COMMAND "${MPIEXEC}" "${RANK_FLAG}" "${RANKS}" ${PREFLAGS} "${APP}" ${POSTFLAGS}
  --dim 1 --order 3 --cells 8 --particles 512 --steps 10 --quadrature_points exact
  --replay plain,jacobi,chebyshev --output "${OUTPUT}"
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "LandauDampingFEM smoke run failed: ${result}")
endif()
file(STRINGS "${OUTPUT}/solves-rank0.csv" rows REGEX "^(initial|step),")
list(LENGTH rows count)
if(NOT count EQUAL 11)
  message(FATAL_ERROR "Expected eleven PIC solves, got ${count}")
endif()

if(EXISTS "${OUTPUT}/timers.csv")
  message(FATAL_ERROR "Default summary mode unexpectedly exported raw timer samples")
endif()
if(NOT EXISTS "${OUTPUT}/timer-summary.csv")
  message(FATAL_ERROR "Missing compact timer summary")
endif()
file(SIZE "${OUTPUT}/timer-summary.csv" timer_bytes)
if(timer_bytes GREATER 65536)
  message(FATAL_ERROR "Small smoke test produced an unexpectedly large timer summary")
endif()
file(STRINGS "${OUTPUT}/timer-summary.csv" timer_rows)
list(REMOVE_AT timer_rows 0)
foreach(row IN LISTS timer_rows)
  if(NOT row MATCHES ",0$")
    message(FATAL_ERROR "Summary mode retained raw samples: ${row}")
  endif()
endforeach()
