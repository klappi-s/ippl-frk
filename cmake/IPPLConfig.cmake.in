@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(MPI COMPONENTS CXX)

# Source-built dependencies export packages in their build directories. Installed
# dependencies should be found relative to this package, including relocated installs.
set(_ipplPrefix "${PACKAGE_PREFIX_DIR}")
set(_ipplBuildTree FALSE)
if(CMAKE_CURRENT_LIST_DIR STREQUAL "@PROJECT_BINARY_DIR@" OR
   CMAKE_CURRENT_LIST_DIR STREQUAL "@PROJECT_BINARY_DIR@/src")
  set(_ipplBuildTree TRUE)
endif()

if(@IPPL_ENABLE_OPENPMD@ OR @IPPL_ENABLE_H5HUT@)
  if(NOT CMAKE_C_COMPILER_LOADED)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "IPPL's I/O dependencies require project(... LANGUAGES C CXX).")
    return()
  endif()
  # A bundled static HDF5 must be found before openPMD so its exported targets
  # resolve to this installation (or build tree), including after relocation.
  if("@IPPL_IO_HDF5_FETCHED@")
    set(HDF5_USE_STATIC_LIBRARIES TRUE)
    if(_ipplBuildTree)
      find_dependency(HDF5 CONFIG COMPONENTS C
        HINTS "@IPPL_IO_HDF5_PACKAGE_HINT@")
    else()
      find_dependency(HDF5 CONFIG COMPONENTS C static HINTS "${_ipplPrefix}")
    endif()
  endif()
endif()

if(@IPPL_ENABLE_OPENPMD@ AND NOT TARGET openPMD::openPMD)
  if(_ipplBuildTree)
    find_dependency(openPMD 0.17.1 CONFIG COMPONENTS @IPPL_OPENPMD_COMPONENTS@
      HINTS "@IPPL_OPENPMD_PACKAGE_HINT@")
  else()
    find_dependency(openPMD 0.17.1 CONFIG COMPONENTS @IPPL_OPENPMD_COMPONENTS@
      HINTS "${_ipplPrefix}" "@openPMD_DIR@")
  endif()
endif()

if(@IPPL_ENABLE_H5HUT@ AND NOT TARGET H5hut::H5hut)
  find_dependency(MPI COMPONENTS C)
  set(HDF5_PREFER_PARALLEL TRUE)
  find_dependency(HDF5 COMPONENTS C)
  if(NOT HDF5_IS_PARALLEL)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "H5hut requires parallel HDF5")
    return()
  endif()
  if("@IPPL_H5HUT_HEADER_LIBRARY@")
    # Rediscover header/library-only installations without a separate find module.
    find_path(H5hut_INCLUDE_DIR H5hut.h
      HINTS ${H5hut_ROOT} ENV H5hut_ROOT ${H5HUT_ROOT} ENV H5HUT_ROOT
      PATH_SUFFIXES include)
    find_library(H5hut_LIBRARY NAMES H5hut h5hut
      HINTS ${H5hut_ROOT} ENV H5hut_ROOT ${H5HUT_ROOT} ENV H5HUT_ROOT
      PATH_SUFFIXES lib lib64)
    mark_as_advanced(H5hut_INCLUDE_DIR H5hut_LIBRARY)
    if(NOT H5hut_INCLUDE_DIR OR NOT H5hut_LIBRARY)
      set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "H5hut headers or library not found. Set H5hut_ROOT or CMAKE_PREFIX_PATH.")
      return()
    endif()
    add_library(H5hut::H5hut UNKNOWN IMPORTED)
    set_target_properties(H5hut::H5hut PROPERTIES
      IMPORTED_LOCATION "${H5hut_LIBRARY}"
      INTERFACE_INCLUDE_DIRECTORIES "${H5hut_INCLUDE_DIR}"
      INTERFACE_LINK_LIBRARIES "HDF5::HDF5;MPI::MPI_C")
  elseif(_ipplBuildTree)
    find_dependency(H5hut CONFIG HINTS "@IPPL_H5HUT_PACKAGE_HINT@")
  elseif("@IPPL_H5HUT_FETCHED@")
    find_dependency(H5hut CONFIG HINTS "${_ipplPrefix}")
  else()
    find_dependency(H5hut CONFIG HINTS "${_ipplPrefix}" "@IPPL_H5HUT_PACKAGE_HINT@")
  endif()
endif()

if(NOT TARGET Kokkos::kokkos)
  if(_ipplBuildTree)
    find_dependency(Kokkos CONFIG HINTS "@IPPL_KOKKOS_PACKAGE_HINT@")
  else()
    find_dependency(Kokkos CONFIG HINTS "${_ipplPrefix}" "@Kokkos_DIR@")
  endif()
endif()

if("@IPPL_HOST_LAPACK_FETCHED@" AND NOT TARGET IPPLHostLapack::lapacke)
  if(_ipplBuildTree)
    find_dependency(IPPLHostLapack CONFIG HINTS "@IPPL_HOST_LAPACK_PREFIX@")
  else()
    find_dependency(IPPLHostLapack CONFIG HINTS "${_ipplPrefix}")
  endif()
endif()

if(@IPPL_ENABLE_KOKKOS_KERNELS@ AND NOT TARGET Kokkos::kokkoskernels)
  if("@IPPL_KOKKOS_KERNELS_NEEDS_MKL@")
    find_dependency(MKL CONFIG)
  endif()
  if(_ipplBuildTree)
    find_dependency(KokkosKernels CONFIG HINTS "@IPPL_KOKKOS_KERNELS_PACKAGE_HINT@")
  else()
    find_dependency(KokkosKernels CONFIG HINTS "${_ipplPrefix}" "@KokkosKernels_DIR@")
  endif()
endif()

# Source-built Heffte is already part of IPPLTargets (see InstallIppl.cmake).
if(@IPPL_ENABLE_FFT@ AND "@Heffte_FOUND@" AND NOT TARGET Heffte::Heffte)
  find_dependency(Heffte CONFIG HINTS "${_ipplPrefix}" "@Heffte_DIR@")
endif()

if(@IPPL_ENABLE_CATALYST@)
  if("@IPPL_CATALYST_USE_MPI@" AND NOT CMAKE_C_COMPILER_LOADED)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "IPPL was built with MPI-enabled Catalyst, which requires the C language. Enable it in the consuming project with project(... LANGUAGES C CXX).")
    return()
  endif()

  if(NOT TARGET catalyst::catalyst)
    message(STATUS "Finding IPPL dependency: Catalyst")

    if(_ipplBuildTree)
      if("@IPPL_CATALYST_FETCHED@")
        find_dependency(catalyst @IPPL_CATALYST_VERSION@ CONFIG
                        HINTS "@IPPL_CATALYST_BUILD_PACKAGE_DIR@")
      else()
        find_dependency(catalyst @IPPL_CATALYST_VERSION@ CONFIG HINTS "@catalyst_DIR@")
      endif()
    elseif("@IPPL_CATALYST_FETCHED@")
      find_dependency(
        catalyst @IPPL_CATALYST_VERSION@ CONFIG
        HINTS
          "${_ipplPrefix}/@CMAKE_INSTALL_LIBDIR@/cmake/@IPPL_CATALYST_PACKAGE_DIRNAME@")
    else()
      find_dependency(catalyst @IPPL_CATALYST_VERSION@ CONFIG
                      HINTS "${_ipplPrefix}" "@catalyst_DIR@")
    endif()

    message(STATUS "Catalyst version ${catalyst_VERSION}")
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/IPPLTargets.cmake")

if("@IPPL_ENABLE_CATALYST@" AND NOT _ipplBuildTree)
  set_property(
    TARGET IPPL::ippl APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
    "IPPL_CATALYST_SCRIPTS_DIR=\"${_ipplPrefix}/@CMAKE_INSTALL_DATADIR@/ippl/catalyst_scripts\"")
endif()

unset(_ipplPrefix)
unset(_ipplBuildTree)
